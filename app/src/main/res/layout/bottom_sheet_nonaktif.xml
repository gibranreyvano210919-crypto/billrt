<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#DEDEDE" />

    <!-- Header Pelanggan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_primary_light"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_person"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_customer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Pelanggan"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_id_pelanggan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ID: -"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="#E2E8F0" />

    <!-- Option 1: Aktifkan Pelanggan -->
    <TextView
        android:id="@+id/option_aktifkan_pelanggan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_button_success_light"
        android:clickable="true"
        android:drawableStart="@drawable/ic_check_circle"
        android:drawablePadding="12dp"
        android:drawableTint="#166534"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:text="Aktifkan Pelanggan"
        android:textColor="#166534"
        android:textSize="15sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_check_circle"
        app:drawableTint="#166534" />

    <!-- Option 2: Hapus Pelanggan -->
    <TextView
        android:id="@+id/option_hapus_pelanggan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_danger_light"
        android:clickable="true"
        android:drawableStart="@drawable/ic_delete"
        android:drawablePadding="12dp"
        android:drawableTint="#991B1B"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:text="Hapus Pelanggan"
        android:textColor="#991B1B"
        android:textSize="15sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/ic_delete"
        app:drawableTint="#991B1B" />

    <!-- Hint Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Pelanggan yang diaktifkan kembali akan muncul di data pelanggan aktif."
        android:textColor="#94A3B8"
        android:textSize="12sp" />

</LinearLayout>
