<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".PelangganAktifDetailFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Data Pelanggan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Pelanggan"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                    <TextView
                        android:id="@+id/tv_id_pelanggan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="ID Pelanggan: " />

                    <TextView
                        android:id="@+id/tv_nama_pelanggan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Nama: " />

                    <TextView
                        android:id="@+id/tv_telepon_pelanggan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Telepon: " />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Rincian Riwayat Tagihan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rincian Riwayat Tagihan"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                    <TextView
                        android:id="@+id/tv_rekap_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Rekap Status: " />

                    <TextView
                        android:id="@+id/tv_jumlah_nunggak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Jumlah Nunggak: " />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Rincian Jaringan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rincian Jaringan"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Username: " />

                    <TextView
                        android:id="@+id/tv_status_koneksi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Status Koneksi: " />

                    <TextView
                        android:id="@+id/tv_uptime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Uptime: " />

                    <TextView
                        android:id="@+id/tv_ip_aktif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="IP Aktif: " />

                    <TextView
                        android:id="@+id/tv_mac_client_live"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="MAC Client Live: " />
                        
                    <TextView
                        android:id="@+id/tv_mac_address_db"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:drawableStart="@android:drawable/ic_menu_save"
                        android:drawablePadding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        tools:text="MAC Address DB: " />

                    <TextView
                        android:id="@+id/tv_total_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Total Usage: " />

                    <TextView
                        android:id="@+id/tv_last_logout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Last Logout: " />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Rincian Data Pelanggan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rincian Data Pelanggan"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                    <TextView
                        android:id="@+id/tv_tgl_daftar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Tanggal Daftar: " />

                    <TextView
                        android:id="@+id/tv_installation_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Tanggal Instalasi: " />

                    <TextView
                        android:id="@+id/tv_alamat_pelanggan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Alamat: " />

                    <TextView
                        android:id="@+id/tv_latlong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Lokasi: " />
                        
                    <TextView
                        android:id="@+id/tv_google_maps_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Google Maps: " />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Paket Internet -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paket Internet"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

                    <TextView
                        android:id="@+id/tv_nama_paket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Nama Paket: " />

                    <TextView
                        android:id="@+id/tv_harga_paket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Harga: " />

                    <TextView
                        android:id="@+id/tv_profile_mikrotik"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Profile Mikrotik: " />

                    <TextView
                        android:id="@+id/tv_wilayah_paket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Wilayah: " />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
