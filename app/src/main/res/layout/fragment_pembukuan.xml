<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PembukuanFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Pemasukkan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Pemasukkan"
                    android:textAppearance="?attr/textAppearanceHeadline6" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">

                    <TextView
                        android:id="@+id/tv_transaksi_cash"
                        style="@style/PembukuanItem"
                        android:text="Transaksi Cash" />

                    <TextView
                        android:id="@+id/tv_transaksi_online"
                        style="@style/PembukuanItem"
                        android:text="Transaksi Online" />

                    <TextView
                        android:id="@+id/tv_total_pemasukkan_lain"
                        style="@style/PembukuanItem"
                        android:text="Total Pemasukkan Lain2" />
                </GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Pengeluaran -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Pengeluaran"
                    android:textAppearance="?attr/textAppearanceHeadline6" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">

                    <TextView
                        android:id="@+id/tv_gaji_karyawan"
                        style="@style/PembukuanItem"
                        android:text="Gaji Karyawan" />

                    <TextView
                        android:id="@+id/tv_pasang_baru"
                        style="@style/PembukuanItem"
                        android:text="Pasang Baru" />

                    <TextView
                        android:id="@+id/tv_perbaikan_alat"
                        style="@style/PembukuanItem"
                        android:text="Perbaikan Alat" />

                    <TextView
                        android:id="@+id/tv_bayar_bandwidth"
                        style="@style/PembukuanItem"
                        android:text="Bayar Bandwith" />

                    <TextView
                        android:id="@+id/tv_bayar_kang_tagih"
                        style="@style/PembukuanItem"
                        android:text="Bayar Kang Tagih" />

                    <TextView
                        android:id="@+id/tv_listrik_pdam_pulsa"
                        style="@style/PembukuanItem"
                        android:text="Listrik / PDAM / Pulsa" />

                    <TextView
                        android:id="@+id/tv_bayar_marketing"
                        style="@style/PembukuanItem"
                        android:text="Bayar Marketing" />

                    <TextView
                        android:id="@+id/tv_lain_lain"
                        style="@style/PembukuanItem"
                        android:text="Lain lain" />
                </GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Menu Laporan & Catatan (Dipindahkan dari Beranda) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Laporan &amp; Catatan"
                    android:textAppearance="?attr/textAppearanceHeadline6" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="4dp">

                    <!-- Menu Riwayat Tunggakan -->
                    <LinearLayout
                        android:id="@+id/card_riwayat_tunggakan"
                        style="@style/MenuLainLayout"
                        android:layout_columnWeight="1">
                        <ImageView
                            style="@style/MenuLainIcon"
                            android:src="@drawable/ic_tunggakan"
                            app:tint="@color/card_tunggakan" />
                        <TextView
                            style="@style/MenuLainText"
                            android:text="Riwayat Tunggakan" />
                    </LinearLayout>

                    <!-- Menu Kas -->
                    <LinearLayout
                        android:id="@+id/card_kas"
                        style="@style/MenuLainLayout"
                        android:layout_columnWeight="1">
                        <ImageView
                            style="@style/MenuLainIcon"
                            android:src="@drawable/ic_cash"
                            app:tint="@color/card_kas" />
                        <TextView
                            style="@style/MenuLainText"
                            android:text="Kas" />
                    </LinearLayout>

                    <!-- Menu Rekap Tunggakan -->
                    <LinearLayout
                        android:id="@+id/card_rekap_tunggakan"
                        style="@style/MenuLainLayout"
                        android:layout_columnWeight="1">
                        <ImageView
                            style="@style/MenuLainIcon"
                            android:src="@drawable/ic_tunggakan"
                            app:tint="@color/card_tunggakan" />
                        <TextView
                            style="@style/MenuLainText"
                            android:text="Tunggakan" />
                    </LinearLayout>

                    <!-- Menu Rekap Tercatat -->
                    <LinearLayout
                        android:id="@+id/card_rekap_tercatat"
                        style="@style/MenuLainLayout"
                        android:layout_columnWeight="1">
                        <ImageView
                            style="@style/MenuLainIcon"
                            android:src="@drawable/ic_tercatat"
                            app:tint="@color/card_tercatat" />
                        <TextView
                            style="@style/MenuLainText"
                            android:text="Tercatat" />
                    </LinearLayout>

                    <!-- Menu Setoran -->
                    <LinearLayout
                        android:id="@+id/card_setoran"
                        style="@style/MenuLainLayout"
                        android:layout_columnWeight="1">
                        <ImageView
                            style="@style/MenuLainIcon"
                            android:src="@drawable/ic_setoran"
                            app:tint="@color/card_setoran" />
                        <TextView
                            style="@style/MenuLainText"
                            android:text="Setoran" />
                    </LinearLayout>

                    <!-- Menu Histori Catat -->
                    <LinearLayout
                        android:id="@+id/card_histori_catat"
                        style="@style/MenuLainLayout"
                        android:layout_columnWeight="1">
                        <ImageView
                            style="@style/MenuLainIcon"
                            android:src="@drawable/ic_history"
                            app:tint="@color/card_histori_catat" />
                        <TextView
                            style="@style/MenuLainText"
                            android:text="Histori Catat" />
                    </LinearLayout>

                    <!-- Menu Validasi Periode -->
                    <LinearLayout
                        android:id="@+id/card_validasi_periode"
                        style="@style/MenuLainLayout"
                        android:layout_columnWeight="1">
                        <ImageView
                            style="@style/MenuLainIcon"
                            android:src="@drawable/ic_validate"
                            app:tint="@color/card_validasi" />
                        <TextView
                            style="@style/MenuLainText"
                            android:text="Validasi Periode" />
                    </LinearLayout>

                </GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Menu Lain -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Menu Lain"
            android:textAppearance="?attr/textAppearanceHeadline6" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4">

            <LinearLayout
                android:id="@+id/menu_uang_di_admin"
                style="@style/MenuLainLayout"
                android:layout_columnWeight="1">

                <ImageView
                    style="@style/MenuLainIcon"
                    android:src="@drawable/ic_uang_admin" />

                <TextView
                    style="@style/MenuLainText"
                    android:text="Uang di Admin" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_semua_pembukuan"
                style="@style/MenuLainLayout"
                android:layout_columnWeight="1">

                <ImageView
                    style="@style/MenuLainIcon"
                    android:src="@drawable/ic_semua_pembukuan" />

                <TextView
                    style="@style/MenuLainText"
                    android:text="Semua Pembukuan" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_pembayaran_rv_admin"
                style="@style/MenuLainLayout"
                android:layout_columnWeight="1">

                <ImageView
                    style="@style/MenuLainIcon"
                    android:src="@drawable/ic_pembayaran_rv_admin" />

                <TextView
                    style="@style/MenuLainText"
                    android:text="Pemb. Rv Admin" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_rangkuman_keuangan"
                style="@style/MenuLainLayout"
                android:layout_columnWeight="1">

                <ImageView
                    style="@style/MenuLainIcon"
                    android:src="@drawable/ic_rangkuman_keuangan" />

                <TextView
                    style="@style/MenuLainText"
                    android:text="Rangkuman Keuangan" />
            </LinearLayout>

        </GridLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
