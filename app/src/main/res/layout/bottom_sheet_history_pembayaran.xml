<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HistoryPembayaranBottomSheetFragment">

    <!-- App Bar / Toolbar Header (Bagian Atas) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Drag Handle untuk Bottom Sheet -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_dot_timeline"
            android:backgroundTint="#D1D5DB" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_close"
            app:title="Riwayat Pembayaran"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Card Profile Pelanggan (Ringkas) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Header Pelanggan dengan Icon & ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_primary_light"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        android:src="@drawable/ic_person"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_nama_pelanggan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="bagas klumutan" />

                        <TextView
                            android:id="@+id/tv_id_pelanggan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            tools:text="ID: 2053" />
                    </LinearLayout>

                    <!-- Filter / Pilihan Tahun -->
                    <Spinner
                        android:id="@+id/spinner_tahun"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:spinnerMode="dropdown"
                        android:visibility="visible"
                        tools:visibility="visible" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#F1F5F9" />

                <!-- Detail Profil Pelanggan -->
                <TextView
                    android:id="@+id/tv_paket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    tools:text="Paket: Paket-Home-1A" />

                <TextView
                    android:id="@+id/tv_wilayah"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    tools:text="Wilayah: Klumutan Kulon Kali" />

                <TextView
                    android:id="@+id/tv_installation_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    tools:text="Tgl Pasang: 2025-07-22" />

                <TextView
                    android:id="@+id/tv_admin_pencatat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/purple_500"
                    android:textSize="11sp"
                    tools:text="Pencatat Terakhir: debi" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Tunggal Berisi Seluruh List 12 Bulan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_timeline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="12"
                tools:listitem="@layout/item_timeline" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>