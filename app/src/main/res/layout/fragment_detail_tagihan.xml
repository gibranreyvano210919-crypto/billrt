<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetailTagihanFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Detail Tagihan" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_invoice_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        tools:background="@drawable/badge_lunas"
                        tools:text="LUNAS" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No. Invoice"
                        android:textAppearance="?attr/textAppearanceCaption" />

                    <TextView
                        android:id="@+id/tv_invoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        tools:text="INV/2023/07/001" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Pelanggan"
                        android:textAppearance="?attr/textAppearanceCaption" />

                    <TextView
                        android:id="@+id/tv_customer_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBody1"
                        tools:text="John Doe" />
                     <TextView
                        android:id="@+id/tv_customer_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBody2"
                        tools:text="john.doe" />

                    <TextView
                        android:id="@+id/tv_customer_phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBody2"
                        tools:text="+62 812-3456-7890" />

                    <TextView
                        android:id="@+id/tv_customer_wilayah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBody2"
                        tools:text="Area 51" />

                    <TextView
                        android:id="@+id/tv_customer_tgl_instalasi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBody2"
                        tools:text="01 Jan 2023" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Detail Lunas -->
            <LinearLayout
                android:id="@+id/layout_lunas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detail Pembayaran"
                            android:textAppearance="?attr/textAppearanceHeadline6" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:columnCount="2">

                            <TextView android:text="Periode"/>
                            <TextView
                                android:id="@+id/tv_lunas_periode"
                                android:gravity="end"
                                android:layout_columnWeight="1"
                                tools:text="Juli/2023"/>
                            <TextView android:text="Tanggal Bayar"/>
                            <TextView
                                android:id="@+id/tv_tgl_bayar"
                                android:gravity="end"
                                android:layout_columnWeight="1"
                                tools:text="15 Jul 2023 10:30"/>
                            <TextView android:text="Nominal"/>
                            <TextView
                                android:id="@+id/tv_lunas_nominal"
                                android:gravity="end"
                                android:layout_columnWeight="1"
                                tools:text="Rp 150.000"/>
                            <TextView android:text="Metode Bayar"/>
                            <TextView
                                android:id="@+id/tv_metode_bayar"
                                android:gravity="end"
                                android:layout_columnWeight="1"
                                tools:text="TUNAI"/>
                             <TextView android:text="Admin"/>
                            <TextView
                                android:id="@+id/tv_admin"
                                android:gravity="end"
                                android:layout_columnWeight="1"
                                tools:text="Admin 1"/>
                             <TextView android:text="Catatan"/>
                            <TextView
                                android:id="@+id/tv_catatan"
                                android:gravity="end"
                                android:layout_columnWeight="1"
                                tools:text="-"/>
                        </GridLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Detail Belum Lunas -->
            <LinearLayout
                android:id="@+id/layout_belum_lunas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                     <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ringkasan Tagihan"
                            android:textAppearance="?attr/textAppearanceHeadline6" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:columnCount="2">
                             <TextView android:text="Periode"/>
                            <TextView
                                android:id="@+id/tv_belum_lunas_periode"
                                android:gravity="end"
                                android:layout_columnWeight="1"
                                tools:text="Juli/2023"/>
                             <TextView android:text="Nominal"/>
                            <TextView
                                android:id="@+id/tv_belum_lunas_nominal"
                                android:gravity="end"
                                android:layout_columnWeight="1"
                                tools:text="Rp 150.000"/>
                             <TextView android:text="Jatuh Tempo"/>
                            <TextView
                                android:id="@+id/tv_jatuh_tempo"
                                android:gravity="end"
                                android:layout_columnWeight="1"
                                tools:text="20 Jul 2023"/>
                        </GridLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_instruksi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/material_on_background_disabled"
                    android:padding="12dp"
                    tools:text="Silakan lakukan pembayaran sebelum tanggal jatuh tempo."/>
                
                 <Button
                    android:id="@+id/btn_confirm_payment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Konfirmasi Pembayaran"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
