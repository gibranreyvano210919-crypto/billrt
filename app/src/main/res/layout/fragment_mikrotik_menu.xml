<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="2"
    android:padding="8dp"
    tools:context=".MikrotikMenuFragment">

    <!-- Card Status Online -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status_online"
        style="@style/DashboardCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_margin="8dp">
        <LinearLayout
            style="@style/DashboardCardContent"
            android:layout_width="match_parent"
            android:layout_height="120dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_user_online" />
            <TextView
                style="@style/DashboardCardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pelanggan Online" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Status Offline -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status_offline"
        style="@style/DashboardCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_margin="8dp">
        <LinearLayout
            style="@style/DashboardCardContent"
            android:layout_width="match_parent"
            android:layout_height="120dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_user_offline" />
            <TextView
                style="@style/DashboardCardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pelanggan Offline" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Audit User -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_audit_user"
        style="@style/DashboardCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_margin="8dp">
        <LinearLayout
            style="@style/DashboardCardContent"
            android:layout_width="match_parent"
            android:layout_height="120dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_audit" />
            <TextView
                style="@style/DashboardCardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Audit User" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card Tambah PPPoe -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tambah_pppoe"
        style="@style/DashboardCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnWeight="1"
        android:layout_margin="8dp">
        <LinearLayout
            style="@style/DashboardCardContent"
            android:layout_width="match_parent"
            android:layout_height="120dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_add_user" />
            <TextView
                style="@style/DashboardCardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tambah PPPoe" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</GridLayout>
