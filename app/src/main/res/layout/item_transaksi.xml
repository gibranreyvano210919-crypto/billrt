<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_nama_pelanggan_transaksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                tools:text="Nama Pelanggan"
                android:textAppearance="?attr/textAppearanceListItem" />

            <TextView
                android:id="@+id/tv_tanggal_transaksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                tools:text="01-01-2026 10:00"
                android:textAppearance="?attr/textAppearanceCaption" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_username_transaksi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="username.pelanggan"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?android:attr/textColorSecondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="8dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <TextView
                android:layout_columnWeight="1"
                android:text="Invoice"/>
            <TextView
                android:id="@+id/tv_invoice_transaksi"
                android:layout_columnWeight="1"
                android:gravity="end"
                tools:text="INV26012345"/>

            <TextView
                android:layout_columnWeight="1"
                android:text="Periode"/>
            <TextView
                android:id="@+id/tv_periode_transaksi"
                android:layout_columnWeight="1"
                android:gravity="end"
                tools:text="1/2026"/>

            <TextView
                android:layout_columnWeight="1"
                android:text="Jumlah"/>
            <TextView
                android:id="@+id/tv_jumlah_transaksi"
                android:layout_columnWeight="1"
                android:gravity="end"
                tools:text="Rp 100.000"/>

            <TextView
                android:layout_columnWeight="1"
                android:text="Metode"/>
            <TextView
                android:id="@+id/tv_metode_transaksi"
                android:layout_columnWeight="1"
                android:gravity="end"
                tools:text="Cash"/>

            <TextView
                android:layout_columnWeight="1"
                android:text="Admin"/>
            <TextView
                android:id="@+id/tv_admin_transaksi"
                android:layout_columnWeight="1"
                android:gravity="end"
                tools:text="Nama Admin"/>

            <TextView
                android:layout_columnWeight="1"
                android:text="Keterangan"/>
            <TextView
                android:id="@+id/tv_keterangan_transaksi"
                android:layout_columnWeight="1"
                android:gravity="end"
                tools:text="-"/>

        </GridLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>